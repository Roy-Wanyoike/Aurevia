// Aurevia — Market Intelligence Infrastructure
// Prisma schema. SQLite for dev/demo. Durable records: backtests, signals,
// orders, positions, risk events. Market data is ephemeral (in-memory simulated feed).
//
// Provider: Prisma 6.x rejects `provider = env("DATABASE_PROVIDER")` with
// P1012 ("A datasource must not use the env() function in the provider
// argument"). The previous "fix #85" attempt used that pattern and silently
// broke `prisma db push` for every subsequent PR — including the schema
// changes in this branch (issue #71). The clean fix is to hard-code the
// dev provider as "sqlite" here; production deployments targeting Postgres
// should maintain a separate `schema.postgres.prisma` and run `prisma
// db push --schema=prisma/schema.postgres.prisma` in their CD pipeline.
// (Equivalent to how Next.js uses `next.config.prod.ts` overrides.)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  hashedPassword String?
  role          String   @default("trader") // trader | admin | viewer
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  memberships   Membership[]
  accounts      Account[]
  sessions      Session[]
  apiKeys       ApiKey[]
  articles      Article[] @relation("AuthoredArticles")
}

// --- NextAuth required models ---
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Multi-tenant: Organizations + Teams + Memberships ---
model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  plan        String   @default("free") // free | pro | enterprise
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  memberships Membership[]
  teams       Team[]
}

model Team {
  id              String   @id @default(cuid())
  name            String
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships     Membership[]
  createdAt       DateTime @default(now())

  @@unique([organizationId, name])
}

model Membership {
  id              String   @id @default(cuid())
  userId          String
  organizationId  String
  teamId          String?
  role            String   @default("member") // owner | admin | member | viewer
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team            Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  @@unique([userId, organizationId])
}

// Catalog of tradeable assets (seeded).
model Asset {
  id        String   @id @default(cuid())
  symbol    String   @unique
  name      String
  exchange  String
  assetType String // equity | crypto | fx | etf
  sector    String?
  currency  String   @default("USD")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// A strategy plugin that generates signals.
model Strategy {
  id          String   @id @default(cuid())
  key         String   @unique // momentum | trend-following | ...
  name        String
  description String
  category    String   // momentum | trend | mean-reversion | breakout | regime
  version     String   @default("1.0.0")
  params      String   // JSON string
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Signals emitted by strategies.
//
// Issue #71 — `userId` + `organizationId` are nullable so the schema is
// forward-compatible with multi-tenant filtering without breaking the
// existing single-tenant dev dataset. Future queries will filter by these
// columns; existing rows stay valid (NULL = system-owned).
model Signal {
  id         String   @id @default(cuid())
  strategyKey String
  symbol     String
  action     String   // BUY | SELL | HOLD | CLOSE
  confidence Float    // 0..1
  price      Float
  reasons    String   // JSON array
  timestamp  DateTime @default(now())
  status     String   @default("PENDING") // PENDING | APPROVED | REJECTED | EXPIRED
  riskReason String?
  userId         String?
  organizationId String?

  @@index([userId])
  @@index([organizationId])
  @@index([symbol, timestamp])
}

// Backtest run metadata + result metrics.
//
// Issue #71 — `userId` + `organizationId` are nullable so the schema is
// forward-compatible with multi-tenant filtering without breaking the
// existing single-tenant dev dataset. NULL = system / shared backtest.
model Backtest {
  id            String   @id @default(cuid())
  strategyKey   String
  symbol        String
  timeframe     String   @default("1d")
  startDate     DateTime
  endDate       DateTime
  initialCapital Float
  status        String   @default("COMPLETED") // PENDING | RUNNING | COMPLETED | FAILED
  totalReturn   Float?
  annualReturn  Float?
  sharpe        Float?
  sortino       Float?
  maxDrawdown   Float?
  winRate       Float?
  trades        Int?
  exposure      Float?
  equityCurve   String?  // JSON array of {t, equity}
  tradesJson    String?  // JSON array of trade objects
  createdAt     DateTime @default(now())
  userId         String?
  organizationId String?

  // ─── Research reproducibility metadata (issue #113) ──────────────────────
  // Captured at backtest-write time so any run can be replayed bit-for-bit.
  // `codeVersion` is the short git SHA at the time of the run; `parameters`
  // is the full JSON of the RunSchema payload (strategyKey, symbol,
  // timeframe, bars, initialCapital, commissionBps, …); `randomSeed` is the
  // seed used by any RNG in the engine (currently the engine is deterministic
  // — these are forward-compatible columns for when ML / Monte-Carlo paths
  // land); `environment` is development | test | production (NODE_ENV).
  codeVersion   String?
  parameters    String?
  randomSeed    Int?
  environment   String?

  @@index([userId])
  @@index([organizationId])
  @@index([symbol, createdAt])
}

// Paper-broker orders.
//
// Issue #71 — `userId` + `organizationId` enable per-tenant order history
// filtering. NULL = system order (e.g. reconciliation fills).
model Order {
  id           String   @id @default(cuid())
  symbol       String
  side         String   // BUY | SELL
  quantity     Float
  orderType    String   @default("MARKET") // MARKET | LIMIT | STOP
  limitPrice   Float?
  status       String   @default("CREATED") // CREATED -> SUBMITTED -> ACKNOWLEDGED -> FILLED | REJECTED | CANCELLED
  filledPrice  Float?
  filledQty    Float?
  strategyKey  String?
  reason       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  userId         String?
  organizationId String?

  @@index([userId])
  @@index([organizationId])
  @@index([symbol, status])
  @@index([createdAt])
}

// Risk profile + circuit breaker state.
//
// Issue #71 — `userId` + `organizationId` enable per-tenant risk profiles.
// NULL = global / system-default profile. Future queries filter by org first
// and fall back to the NULL row when no org-specific override exists.
model RiskProfile {
  id                String   @id @default(cuid())
  name              String   @unique
  maxPositionPct    Float    @default(0.25)
  maxPortfolioPct   Float    @default(1.0)
  maxLeverage       Float    @default(1.0)
  maxDailyLossPct   Float    @default(0.03)
  maxWeeklyLossPct  Float    @default(0.06)
  maxDrawdownPct    Float    @default(0.10)
  maxSpread         Float    @default(0.005)
  maxVolatility     Float    @default(0.05)
  minLiquidity      Float    @default(10000)
  cooldownMinutes   Int      @default(15)
  circuitBreakerState String @default("NORMAL") // NORMAL | CAUTION | TRADING_PAUSED | RE_EVALUATING
  tradingMode       String   @default("PAPER") // ANALYSIS_ONLY | PAPER | SANDBOX | LIVE
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  userId            String?
  organizationId    String?

  @@index([userId])
  @@index([organizationId])
}

model RiskEvent {
  id         String   @id @default(cuid())
  type       String   // CIRCUIT_BREAKER_TRIGGER | LIMIT_BREACH | STALE_DATA | ...
  severity   String   // INFO | WARNING | CRITICAL
  message    String
  context    String?  // JSON
  timestamp  DateTime @default(now())
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  hashedKey  String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ═══════════════════════════════════════════════════════════════════════════
// RESEARCH HUB — Blog / CMS module (issue #128).
// Aurevia operators publish market research and trade commentary. Articles
// are authored markdown documents with categories, tags, cover images,
// engagement analytics (views / likes / comments), and AI-assisted
// authoring (auto-summary, tag suggestions, draft polish).
// ═══════════════════════════════════════════════════════════════════════════

model Article {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  excerpt       String?
  // Markdown source. Rendered client-side via a small markdown renderer.
  // Keeps storage format neutral (HTML can be derived) and avoids XSS risk
  // from storing pre-rendered HTML.
  content       String    @default("")
  coverImageUrl String?
  status        String    @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  featured      Boolean   @default(false)
  readingMinutes Int      @default(1)
  viewCount     Int       @default(0)
  likeCount     Int       @default(0)
  commentCount  Int       @default(0)
  tags          String    @default("[]") // JSON array of tag strings
  // AI-generated metadata cached on the article so the dashboard / list
  // view don't re-call the LLM on every render. Regenerated when the
  // author saves and asks for AI assist.
  aiSummary     String?
  aiTags        String? // JSON array
  aiSentiment   String?  // bullish | bearish | neutral
  authorId      String?
  author        User?    @relation("AuthoredArticles", fields: [authorId], references: [id], onDelete: SetNull)
  categoryId    String?
  category      Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  comments      ArticleComment[]
  likes         ArticleLike[]
  views         ArticleView[]

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([authorId])
  @@index([featured])
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  color       String   @default("#10b981") // accent used in chips + charts
  createdAt   DateTime @default(now())
  articles    Article[]
}

model ArticleComment {
  id          String   @id @default(cuid())
  articleId   String
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  authorName  String
  authorId    String?
  content     String
  // Optional parentId enables one-level threaded replies. Nested deeper
  // replies flatten to the top-level comment (UX choice — keeps the
  // conversation scannable).
  parentId    String?
  // Soft-delete / moderation states. `pending` is shown to moderators only
  // (not implemented in this PR — placeholder for the moderation queue).
  status      String   @default("visible") // visible | hidden | pending
  createdAt   DateTime @default(now())

  @@index([articleId, createdAt])
  @@index([parentId])
}

model ArticleLike {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId    String?
  // Anonymous likes are bucketed by a fingerprint hash (IP+UA). Allows
  // per-browser deduplication without requiring an account.
  fingerprint String?
  createdAt DateTime @default(now())

  @@unique([articleId, fingerprint])
  @@index([articleId])
}

model ArticleView {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  // Per-day rollup key (YYYY-MM-DD). The dashboard groups by this to render
  // the views-over-time chart without needing a time-series DB.
  day       String
  createdAt DateTime @default(now())

  @@index([articleId, day])
  @@index([day])
}

model AuditLog {
  id         String   @id @default(cuid())
  actor      String
  action     String
  entity     String
  entityId   String?
  detail     String?
  timestamp  DateTime @default(now())
}

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 0 — PRODUCTION DATA MODEL
// ═══════════════════════════════════════════════════════════════════════════

// ─── MARKET DATA PERSISTENCE ───────────────────────────────────────────────
// Stores historical OHLCV candles for backtesting and analysis.
// In production, use TimescaleDB hypertables or partition by time.
model MarketCandle {
  id        String   @id @default(cuid())
  symbol    String
  timeframe String   // 1m | 5m | 15m | 1h | 4h | 1d
  time      DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float
  source    String   @default("simulated") // simulated | polygon | alpaca | finnhub
  createdAt DateTime @default(now())

  @@unique([symbol, timeframe, time])
  @@index([symbol, timeframe, time])
  @@index([time])
}

// Latest quotes — updated on every tick.
model MarketQuote {
  id        String   @id @default(cuid())
  symbol    String   @unique
  price     Float
  bid       Float
  ask       Float
  spread    Float
  volume24h Float
  changePct Float
  timestamp DateTime
  source    String   @default("simulated")
  updatedAt DateTime @updatedAt

  @@index([timestamp])
}

// ─── MARKET INTELLIGENCE ───────────────────────────────────────────────────
// Cached indicator snapshots per asset per timeframe.
model MarketFeature {
  id         String   @id @default(cuid())
  symbol     String
  timeframe  String
  time       DateTime
  indicators String   // JSON: {sma20, rsi14, macd, ...}
  trend      String   // JSON: {direction, strength, duration, ...}
  regime     String   // BULL | BEAR | SIDEWAYS | ...
  createdAt  DateTime @default(now())

  @@unique([symbol, timeframe, time])
  @@index([symbol, time])
  @@index([regime])
}

// ─── HISTORICAL MEMORY ─────────────────────────────────────────────────────
// Stores historical market states for similarity matching.
model HistoricalPattern {
  id         String   @id @default(cuid())
  symbol     String
  date       DateTime
  features   String   // JSON snapshot of indicators + trend + regime
  forwardReturn5d  Float?
  forwardReturn20d Float?
  createdAt  DateTime @default(now())

  @@index([symbol, date])
}

// ─── NEWS + EVENTS ─────────────────────────────────────────────────────────
model NewsArticle {
  id          String   @id @default(cuid())
  headline    String
  summary     String?
  url         String   @unique
  source      String   // reuters | bloomberg | finnhub | ...
  symbols     String   // JSON array of mentioned symbols
  sentiment   Float?   // -1..1
  importance  String   @default("medium") // low | medium | high
  publishedAt DateTime
  createdAt   DateTime @default(now())

  @@index([publishedAt])
  @@index([source])
}

model MarketEvent {
  id          String   @id @default(cuid())
  type        String   // earnings | dividend | split | economic | central_bank
  symbol      String?
  title       String
  description String?
  importance  String   @default("medium") // low | medium | high | critical
  scheduledAt DateTime
  resolvedAt  DateTime?
  impact      String?  // JSON: {affectedSymbols, historicalImpact}
  createdAt   DateTime @default(now())

  @@index([scheduledAt])
  @@index([symbol])
  @@index([type])
}

// ─── PORTFOLIO SNAPSHOTS ───────────────────────────────────────────────────
// Periodic snapshots for equity curve tracking + drawdown analysis.
//
// Issue #71 — `userId` + `organizationId` enable per-tenant portfolio
// history. NULL = system portfolio (the demo / paper-trading default).
model PortfolioSnapshot {
  id          String   @id @default(cuid())
  cash        Float
  equity      Float
  marketValue Float
  unrealizedPnl Float
  realizedPnl Float
  feesPaid    Float
  exposure    Float
  drawdown    Float
  positions   String   // JSON array of position snapshots
  timestamp   DateTime @default(now())
  userId         String?
  organizationId String?

  @@index([timestamp])
  @@index([userId, timestamp])
  @@index([organizationId, timestamp])
}

// ─── EVENT LOG (audit-grade) ───────────────────────────────────────────────
// Immutable event log for the full trading pipeline.
// Every important state change gets an event record.
model EventLog {
  id             String   @id @default(cuid())
  eventType      String   // MARKET_PRICE_UPDATED | SIGNAL_CREATED | RISK_CHECK_PASSED | ORDER_CREATED | ORDER_FILLED | ...
  correlationId  String?  // links events in the same request/trade
  causationId    String?  // links an event to its cause
  actorId        String?  // user or system component
  tenantId       String?  // organization ID (multi-tenant)
  schemaVersion  Int      @default(1)
  payload        String   // JSON event payload
  timestamp      DateTime @default(now())

  @@index([eventType, timestamp])
  @@index([correlationId])
}

// ─── ALERTS ────────────────────────────────────────────────────────────────
//
// Issue #71 — `userId` + `organizationId` enable per-tenant alert routing.
// NULL = system / broadcast alert (visible to everyone).
model Alert {
  id         String   @id @default(cuid())
  type       String   // price | indicator | regime | risk | system
  symbol     String?
  condition  String   // JSON: {metric, operator, threshold}
  channel    String   @default("in-app") // in-app | email | webhook
  active     Boolean  @default(true)
  triggeredAt DateTime?
  createdAt  DateTime @default(now())
  userId         String?
  organizationId String?

  @@index([active, type])
  @@index([userId])
  @@index([organizationId])
}

// ─── BROKER CONNECTIONS ────────────────────────────────────────────────────
model BrokerConnection {
  id          String   @id @default(cuid())
  brokerId    String   // alpaca | ibkr | oanda | coinbase | paper
  brokerName  String
  accountId   String?
  mode        String   @default("PAPER") // PAPER | SANDBOX | LIVE
  status      String   @default("DISCONNECTED") // DISCONNECTED | CONNECTING | CONNECTED | ERROR
  apiKeyRef   String?  // reference to secret in secret manager (never the key itself)
  lastSyncAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([brokerId, accountId])
}

// ─── RECONCILIATION ─────────────────────────────────────────────────────────
model ReconciliationRun {
  id          String   @id @default(cuid())
  status      String   @default("PENDING") // PENDING | COMPLETED | MISMATCH
  internalState String // JSON
  externalState String // JSON
  diffs       String?  // JSON array of mismatches
  createdAt   DateTime @default(now())

  @@index([status, createdAt])
}
