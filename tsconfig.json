{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    // Issue #81 — strict mode is on. `noUncheckedIndexedAccess` is
    // intentionally left off (default) — enabling it would force `T | undefined`
    // annotations on every array/record access and break too much existing
    // engine code that's already proven correct via the 155-test suite.
    // Re-evaluate when the engine layer is fully converted to branded types.
    "noUncheckedIndexedAccess": false,
    "noEmit": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "examples",
    "skills",
    ".zscripts",
    "mini-services"
  ]
}
