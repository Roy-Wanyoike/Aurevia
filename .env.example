# ═══════════════════════════════════════════════════════════════════════════
# AUREVIA — PRODUCTION ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════
#
# Copy this file to `.env` and fill in the values.
# NEVER commit the real `.env` file. It is gitignored.
#
# All secrets must be:
#   - Trading-only API keys (withdrawal DISABLED)
#   - Stored in a secret manager in production (AWS Secrets Manager, Doppler, Vault)
#   - Never logged, never committed, never exposed in error messages
#   - Rotated regularly
#
# Default trading mode is PAPER. LIVE requires explicit configuration
# and multiple safeguards. Do not enable LIVE without reading RISK-MANAGEMENT.md.
#
# Issue #84 — every var below is grouped by status:
#   ACTIVE    → referenced in src/, mini-services/, prisma/, or next.config.ts
#   UNUSED    → not referenced anywhere in the codebase; kept as a documented
#               placeholder for future providers. Uncomment when wiring it up.
# ═══════════════════════════════════════════════════════════════════════════

# ─── DATABASE ───────────────────────────────────────────────────────────────
# SQLite for local dev. The Prisma schema hard-codes `provider = "sqlite"`
# (Prisma 6.x rejects `provider = env(...)` with P1012). For Postgres,
# maintain a separate `schema.postgres.prisma` and run `prisma db push
# --schema=prisma/schema.postgres.prisma` in CD.
DATABASE_URL="file:./db/custom.db"
# UNUSED — provider is hard-coded in prisma/schema.prisma.
# DATABASE_PROVIDER="postgresql"
# DATABASE_URL="postgresql://aurevia:${POSTGRES_PASSWORD}@localhost:5432/aurevia?schema=public"

# ─── NEXTAUTH (Authentication) ──────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-32-byte-random-string"
# UNUSED — NextAuth auto-derives the URL from request headers when not set.
# Set this only behind a reverse proxy that rewrites Host / X-Forwarded-Host.
# NEXTAUTH_URL="http://localhost:3000"

# OAuth providers (optional — enables social login). The NextAuth config
# reads GOOGLE_ID / GOOGLE_SECRET / GITHUB_ID / GITHUB_SECRET directly.
# GOOGLE_ID=""
# GOOGLE_SECRET=""
# GITHUB_ID=""
# GITHUB_SECRET=""

# ─── TRADING SAFETY ─────────────────────────────────────────────────────────
# UNUSED — TRADING_MODE is documented for ops reference but not read by the
# app. The runtime trading mode is mutated via the Risk API
# (POST /api/v1/risk { action: "updateProfile", tradingMode: "PAPER" }) and
# persisted in the RiskProfile. Default is PAPER.
# TRADING_MODE="PAPER"

# ─── MARKET DATA PROVIDERS ──────────────────────────────────────────────────
# At least one provider is required for live data. Without these, Aurevia
# falls back to the deterministic simulated feed (labeled as such).
# Polygon.io — recommended for US equities, crypto, forex. ACTIVE.
POLYGON_API_KEY=""
# UNUSED — Alpha Vantage provider adapter is not yet wired up.
# ALPHA_VANTAGE_API_KEY=""
# UNUSED — Finnhub provider adapter is not yet wired up.
# FINNHUB_API_KEY=""
# UNUSED — CoinGecko provider adapter is not yet wired up.
# COINGECKO_API_KEY=""
# UNUSED — Tiingo provider adapter is not yet wired up.
# TIINGO_API_KEY=""
# UNUSED — Twelve Data provider adapter is not yet wired up.
# TWELVE_DATA_API_KEY=""

# ─── BROKER ADAPTERS ────────────────────────────────────────────────────────
# CRITICAL: All broker API keys MUST be trading-only (withdrawal DISABLED).
# Never use unrestricted keys. Never give the AI wallet authority.
#
# UNUSED — the Alpaca adapter (`src/lib/aurevia/brokers/alpaca.ts`) is a
# stub. It does NOT call the Alpaca API. Wiring real network calls is on
# the Phase 7 roadmap. Set credentials here when that adapter is enabled.
# ALPACA_API_KEY=""
# ALPACA_API_SECRET=""
# ALPACA_BASE_URL="https://paper-api.alpaca.markets"
# ALPACA_BASE_URL="https://api.alpaca.markets"  # live

# UNUSED — the IBKR adapter (`src/lib/aurevia/brokers/ibkr.ts`) is a stub.
# IBKR_API_KEY=""
# IBKR_API_SECRET=""
# IBKR_ACCOUNT_ID=""
# IBKR_BASE_URL="https://localhost:5000"  # Client Portal Gateway

# UNUSED — no OANDA adapter exists yet.
# OANDA_API_KEY=""
# OANDA_ACCOUNT_ID=""
# OANDA_BASE_URL="https://api-fxpractice.oanda.com"

# UNUSED — no Coinbase adapter exists yet.
# COINBASE_API_KEY=""
# COINBASE_API_SECRET=""

# ─── AI / ML ────────────────────────────────────────────────────────────────
# UNUSED — `z-ai-web-dev-sdk` reads its config from `.z-ai-config`, NOT
# from environment variables. The ZAI_API_KEY var here is therefore never
# read by the codebase. Kept as a documentation marker only.
# ZAI_API_KEY=""

# UNUSED — alternative LLM provider not yet wired up.
# OPENAI_API_KEY=""

# ─── WEBSOCKET STREAMING ────────────────────────────────────────────────────
# UNUSED — the aurevia-stream mini-service hard-codes port 3003 in
# `mini-services/aurevia-stream/index.ts`. To change it, edit the constant
# there. This env var is not read by any process.
# STREAM_SERVICE_PORT="3003"

# ─── OBSERVABILITY ──────────────────────────────────────────────────────────
# UNUSED — Sentry integration is not yet wired up. Add the SDK + a
# `Sentry.init()` call in `instrumentation.ts` before enabling.
# SENTRY_DSN=""
# SENTRY_AUTH_TOKEN=""
# NEXT_PUBLIC_SENTRY_DSN=""

# Log level: debug | info | warn | error. ACTIVE — read by src/lib/aurevia/logger.ts.
LOG_LEVEL="info"

# ─── REDIS (optional — for multi-instance caching + pub/sub) ────────────────
# Only needed if running multiple Next.js instances behind a load balancer.
# Single-instance dev does NOT need Redis.
# REDIS_URL="redis://localhost:6379"

# ─── RATE LIMITING ──────────────────────────────────────────────────────────
# API rate limit (requests per minute per IP). ACTIVE — read by src/lib/aurevia/rate-limit.ts.
RATE_LIMIT_PER_MINUTE="60"

# ─── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use * for dev only.
# ACTIVE — read by mini-services/aurevia-stream/index.ts.
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# ─── DEPLOYMENT ─────────────────────────────────────────────────────────────
# ACTIVE — read by NextAuth + various places that need the canonical URL.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# ACTIVE — read by Next.js itself.
NODE_ENV="development"
# UNUSED — no branding component reads this. Kept as a placeholder for the
# next branding pass.
# NEXT_PUBLIC_BRANDING_NAME="Aurevia"

# ─── FEATURE FLAGS ──────────────────────────────────────────────────────────
# UNUSED — no code path reads these flags. They were planned as
# runtime-toggleable features but the toggle plumbing was never added.
# NEXT_PUBLIC_ENABLE_ML="true"
# NEXT_PUBLIC_ENABLE_BROKER_CONNECT="true"
# NEXT_PUBLIC_ENABLE_LIVE_TRADING="false"  # NEVER set to true without safety review
# NEXT_PUBLIC_ENABLE_AI_COPILOT="false"
# NEXT_PUBLIC_ENABLE_MARKET_REPLAY="false"

# ─── SECURITY ───────────────────────────────────────────────────────────────
# API key required for /api/v1/* routes in production (issue #70/#61/#60).
# Generate with: openssl rand -hex 32
# Clients pass it as `x-api-key: <key>` OR `Authorization: Bearer <key>`.
# In dev (NODE_ENV !== "production") auth is bypassed with a warning.
# ACTIVE — read by src/lib/aurevia/auth/check.ts.
AUREVIA_API_KEY=""
# Content Security Policy nonce (generated per-request in production)
# CSP_REPORT_ONLY="false"

# ─── DATABASE CONNECTION POOLING (production) ───────────────────────────────
# When using PostgreSQL with PgBouncer or similar
# DATABASE_CONNECTION_LIMIT="10"
# DATABASE_POOL_TIMEOUT="30"

# ═══════════════════════════════════════════════════════════════════════════
# SAFETY CHECKLIST — verify before going live:
# ═══════════════════════════════════════════════════════════════════════════
# [ ] Runtime trading mode is PAPER (check /api/v1/health, not env)
# [ ] All broker API keys have withdrawal DISABLED
# [ ] NEXTAUTH_SECRET is a strong random string
# [ ] DATABASE_URL points to a backed-up production database
# [ ] SENTRY_DSN is set for error monitoring
# [ ] CORS_ALLOWED_ORIGINS does not include *
# [ ] No secrets are committed to git (run: git ls-files | grep -i env)
# [ ] .env file is in .gitignore
# [ ] Rate limiting is enabled
# [ ] At least one market data provider key is set (or simulated feed is clearly labeled)
# ═══════════════════════════════════════════════════════════════════════════
