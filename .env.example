# ═══════════════════════════════════════════════════════════════════════════
# AUREVIA — PRODUCTION ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════
#
# Copy this file to `.env` and fill in the values.
# NEVER commit the real `.env` file. It is gitignored.
#
# All secrets must be:
#   - Trading-only API keys (withdrawal DISABLED)
#   - Stored in a secret manager in production (AWS Secrets Manager, Doppler, Vault)
#   - Never logged, never committed, never exposed in error messages
#   - Rotated regularly
#
# Default trading mode is PAPER. LIVE requires explicit configuration
# and multiple safeguards. Do not enable LIVE without reading RISK-MANAGEMENT.md.
# ═══════════════════════════════════════════════════════════════════════════

# ─── DATABASE ───────────────────────────────────────────────────────────────
# SQLite for local dev. Use PostgreSQL for production.
# Set DATABASE_PROVIDER=postgresql in production and update DATABASE_URL.
DATABASE_PROVIDER="sqlite"
DATABASE_URL="file:./db/custom.db"
# DATABASE_PROVIDER="postgresql"
# DATABASE_URL="postgresql://aurevia:${POSTGRES_PASSWORD}@localhost:5432/aurevia?schema=public"

# ─── NEXTAUTH (Authentication) ──────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-32-byte-random-string"
# The canonical URL of your deployment (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# OAuth providers (optional — enables social login)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# ─── TRADING SAFETY ─────────────────────────────────────────────────────────
# Default is PAPER. Never set LIVE without reading the safety docs.
# Options: ANALYSIS_ONLY | PAPER | SANDBOX | LIVE
TRADING_MODE="PAPER"

# ─── MARKET DATA PROVIDERS ──────────────────────────────────────────────────
# At least one provider is required for live data. Without these, Aurevia
# falls back to the deterministic simulated feed (labeled as such).
# Polygon.io — recommended for US equities, crypto, forex
POLYGON_API_KEY=""
# Alpha Vantage — free tier, rate-limited
ALPHA_VANTAGE_API_KEY=""
# Finnhub — fundamentals, news, alternative data
FINNHUB_API_KEY=""
# CoinGecko — crypto (free, no key required for basic tier)
# COINGECKO_API_KEY=""
# Tiingo — IEX historical data
TIINGO_API_KEY=""
# Twelve Data — forex, equities, crypto
TWELVE_DATA_API_KEY=""

# ─── BROKER ADAPTERS ────────────────────────────────────────────────────────
# CRITICAL: All broker API keys MUST be trading-only (withdrawal DISABLED).
# Never use unrestricted keys. Never give the AI wallet authority.
# ────────────────────────────────────────────────────────────────────────────

# Alpaca — paper trading (default) or live
ALPACA_API_KEY=""
ALPACA_API_SECRET=""
ALPACA_BASE_URL="https://paper-api.alpaca.markets"
# For live: ALPACA_BASE_URL="https://api.alpaca.markets"

# Interactive Brokers — Client Portal Web API
IBKR_API_KEY=""
IBKR_API_SECRET=""
IBKR_ACCOUNT_ID=""
IBKR_BASE_URL="https://localhost:5000"  # Client Portal Gateway runs locally

# OANDA — forex (practice or live)
OANDA_API_KEY=""
OANDA_ACCOUNT_ID=""
OANDA_BASE_URL="https://api-fxpractice.oanda.com"

# Coinbase Advanced Trade — crypto
COINBASE_API_KEY=""
COINBASE_API_SECRET=""

# ─── AI / ML ────────────────────────────────────────────────────────────────
# Z.ai SDK for AI Research Copilot, signal explanations, NL screening
ZAI_API_KEY=""

# OpenAI (optional — for alternative LLM provider)
# OPENAI_API_KEY=""

# ─── WEBSOCKET STREAMING ────────────────────────────────────────────────────
# The aurevia-stream mini-service port (runs alongside Next.js)
STREAM_SERVICE_PORT="3003"

# ─── OBSERVABILITY ──────────────────────────────────────────────────────────
# Sentry — error tracking + performance monitoring
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Log level: debug | info | warn | error
LOG_LEVEL="info"

# ─── REDIS (optional — for multi-instance caching + pub/sub) ────────────────
# Only needed if running multiple Next.js instances behind a load balancer.
# Single-instance dev does NOT need Redis.
# REDIS_URL="redis://localhost:6379"

# ─── RATE LIMITING ──────────────────────────────────────────────────────────
# API rate limit (requests per minute per IP)
RATE_LIMIT_PER_MINUTE="60"

# ─── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use * for dev only.
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# ─── DEPLOYMENT ─────────────────────────────────────────────────────────────
NODE_ENV="development"
# NEXT_PUBLIC_APP_URL is exposed to the client — use for canonical URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BRANDING_NAME="Aurevia"

# ─── FEATURE FLAGS ──────────────────────────────────────────────────────────
# Toggle features on/off without code changes
NEXT_PUBLIC_ENABLE_ML="true"
NEXT_PUBLIC_ENABLE_BROKER_CONNECT="true"
NEXT_PUBLIC_ENABLE_LIVE_TRADING="false"  # NEVER set to true without safety review
NEXT_PUBLIC_ENABLE_AI_COPILOT="false"    # Coming soon
NEXT_PUBLIC_ENABLE_MARKET_REPLAY="false" # Coming soon

# ─── SECURITY ───────────────────────────────────────────────────────────────
# Content Security Policy nonce (generated per-request in production)
# CSP_REPORT_ONLY="false"

# ─── DATABASE CONNECTION POOLING (production) ───────────────────────────────
# When using PostgreSQL with PgBouncer or similar
# DATABASE_CONNECTION_LIMIT="10"
# DATABASE_POOL_TIMEOUT="30"

# ═══════════════════════════════════════════════════════════════════════════
# SAFETY CHECKLIST — verify before going live:
# ═══════════════════════════════════════════════════════════════════════════
# [ ] TRADING_MODE is PAPER (not LIVE)
# [ ] All broker API keys have withdrawal DISABLED
# [ ] NEXTAUTH_SECRET is a strong random string
# [ ] DATABASE_URL points to a backed-up production database
# [ ] SENTRY_DSN is set for error monitoring
# [ ] CORS_ALLOWED_ORIGINS does not include *
# [ ] No secrets are committed to git (run: git ls-files | grep -i env)
# [ ] .env file is in .gitignore
# [ ] Rate limiting is enabled
# [ ] At least one market data provider key is set (or simulated feed is clearly labeled)
# ═══════════════════════════════════════════════════════════════════════════
