# Aurevia — Environment Variables (copy this file to `.env`)

# Database
DATABASE_URL=file:./db/custom.db

# NextAuth (not yet wired — placeholder for future auth work)
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32

# Broker credentials — NEVER commit real values.
# Trading-only API keys, withdrawal permission DISABLED.
# IBKR_API_KEY=
# IBKR_API_SECRET=
# ALPACA_API_KEY=
# ALPACA_API_SECRET=
# OANDA_API_KEY=
# OANDA_API_SECRET=
# COINBASE_API_KEY=
# COINBASE_API_SECRET=

# Market data providers
# POLYGON_API_KEY=
# ALPHA_VANTAGE_API_KEY=
# FINNHUB_API_KEY=

# Trading mode — defaults to PAPER for safety
TRADING_MODE=PAPER

# NextAuth (multi-tenant auth)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32
